@prefix domain: <https://ethwcmk.org/ontology/domain/> .
@prefix eth: <https://ethwcmk.org/ontology/eth/> .
@prefix facet: <https://ethwcmk.org/ontology/facet/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pillar: <https://ethwcmk.org/ontology/pillar/> .
@prefix policy: <https://ethwcmk.org/ontology/policy/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pillar:Can eth:contributedBy facet:C1,
        facet:C2,
        facet:C3,
        facet:C4,
        facet:C5,
        facet:C6,
        facet:K4,
        facet:K8,
        facet:W1,
        facet:W4,
        facet:W5 .

pillar:Know eth:contributedBy facet:K1,
        facet:K2,
        facet:K3,
        facet:K4,
        facet:K5,
        facet:K6,
        facet:K7,
        facet:K8,
        facet:M4 .

pillar:Must eth:contributedBy facet:C2,
        facet:C3,
        facet:C4,
        facet:C6,
        facet:K3,
        facet:K6,
        facet:K7,
        facet:M1,
        facet:M2,
        facet:M3,
        facet:M4,
        facet:M5,
        facet:M6,
        facet:W2,
        facet:W3,
        facet:W6 .

pillar:Want eth:contributedBy facet:K5,
        facet:M6,
        facet:W1,
        facet:W2,
        facet:W3,
        facet:W4,
        facet:W5,
        facet:W6 .

policy:uncertainty_penalized_mean a eth:AggregationPolicy ;
    rdfs:label "uncertainty_penalized_mean"@en .

policy:threshold_override a eth:AggregationPolicy ;
    rdfs:label "threshold_override"@en .

policy:weighted_mean a eth:AggregationPolicy ;
    rdfs:label "weighted_mean"@en .

policy:guarded_weighted_mean a eth:AggregationPolicy ;
    rdfs:label "guarded_weighted_mean"@en .

facet:C1 a owl:NamedIndividual,
        eth:Facet ;
    rdfs:label "Functional capability"@en ;
    skos:prefLabel "Functional capability"@en ;
    eth:aggregationPolicy policy:weighted_mean ;
    eth:betaCan 1.0 ;
    eth:betaKnow 0.0 ;
    eth:betaMust 0.0 ;
    eth:betaWant 0.0 ;
    eth:facetCode "C1" ;
    eth:facetWeight 1.0 ;
    eth:hasGuard false ;
    eth:source "catalog" .

