    rdfs:label "Domain"@en .

eth:FacetDomainCriticality a owl:Class ;
    rdfs:label "FacetDomainCriticality"@en .

eth:FacetRequirement a owl:Class ;
    rdfs:label "FacetRequirement"@en ;
    owl:disjointWith eth:FacetLevel .

eth:RelationalSlot a owl:Class ;
    rdfs:label "RelationalSlot"@en ;
    owl:disjointWith eth:Facet .

eth:FacetLevel a owl:Class ;
    rdfs:label "FacetLevel"@en .

eth:Pillar a owl:Class ;
    rdfs:label "Pillar"@en ;
    owl:disjointWith eth:Facet .

eth:AgencyProfile a owl:Class ;
    rdfs:label "AgencyProfile"@en .

eth:EthicalCase a owl:Class ;
    rdfs:label "EthicalCase"@en ;
    owl:disjointWith eth:AgencyProfile .

eth:Facet a owl:Class ;
    rdfs:label "Facet"@en ;
    owl:disjointWith eth:Decision .

eth:Confrontation a owl:Class ;
    rdfs:label "Confrontation"@en ;
    owl:disjointWith eth:Calibration .

eth:Calibration a owl:Class ;
    rdfs:label "Calibration"@en .

