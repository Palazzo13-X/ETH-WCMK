eth:AggregationPolicy a owl:Class ;
    rdfs:label "AggregationPolicy"@en .

eth:PrudentialMode a owl:Class ;
    rdfs:label "PrudentialMode"@en .

eth:ReversibilityGrade a owl:Class ;
