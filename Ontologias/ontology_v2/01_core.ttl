@prefix eth: <https://ethwcmk.org/ontology/eth/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ethwcmk.org/ontology/> a owl:Ontology ;
    rdfs:label "ETH-WCMK ontology v2"@en ;
    rdfs:comment "Consolidated namespace replacing eth2.local/ontology, ethwcmk.org/ontology and eth2.ai/ontology. Facets are individuals; the tetrahedron is a relational index (face lattice of the 3-simplex), not a metric state space."@en .

eth:adequacy a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "adequacy"@en ;
    rdfs:domain eth:Confrontation ;
    rdfs:range xsd:decimal .

eth:adequacyRaw a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "adequacyRaw"@en ;
    rdfs:domain eth:Confrontation ;
    rdfs:range xsd:decimal .

