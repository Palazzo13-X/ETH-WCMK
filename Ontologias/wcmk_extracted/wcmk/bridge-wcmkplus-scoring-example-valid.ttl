ex:req_profile_health a efr:CaseRequirementProfile ;
    efr:derivedFromCase ex:case_health_triage ;
    efr:usesSeverityBand efr:SEVERITY_CRITICAL ;
    efr:usesPrudentialMode efr:PRUDENTIAL_MAXIMUM ;
    efr:usesAggregationProfile efr:ConservativeRequirementAggregation ;
    efr:requirementCoverage "1.00"^^xsd:decimal ;
    efr:derivedRequirementCount "24"^^xsd:integer ;
    efr:hasDerivedRequirement ex:req_GoalOrientation ;
    efr:hasDerivedRequirement ex:req_ValueAlignment ;
    efr:hasDerivedRequirement ex:req_StakeholderRegard ;
    efr:hasDerivedRequirement ex:req_PriorityDiscipline ;
    efr:hasDerivedRequirement ex:req_IntentionalStability ;
    efr:hasDerivedRequirement ex:req_FunctionalCapability ;
    efr:hasDerivedRequirement ex:req_Robustness ;
    efr:hasDerivedRequirement ex:req_Controllability ;
    efr:hasDerivedRequirement ex:req_ScopeAdequacy ;
    efr:hasDerivedRequirement ex:req_ResourceSufficiency ;
    efr:hasDerivedRequirement ex:req_SafeExecutability ;
    efr:hasDerivedRequirement ex:req_LegalObligation ;
    efr:hasDerivedRequirement ex:req_InstitutionalPolicyObligation ;
    efr:hasDerivedRequirement ex:req_EthicalPrincipleObligation ;
    efr:hasDerivedRequirement ex:req_PrudentialObligation ;
    efr:hasDerivedRequirement ex:req_RoleObligation ;
    efr:hasDerivedRequirement ex:req_AccountabilityObligation ;
    efr:hasDerivedRequirement ex:req_EvidentialKnowledge ;
    efr:hasDerivedRequirement ex:req_ContextualKnowledge ;
    efr:hasDerivedRequirement ex:req_NormativeKnowledge ;
    efr:hasDerivedRequirement ex:req_ProceduralKnowledge ;
    efr:hasDerivedRequirement ex:req_CausalKnowledge ;
    efr:hasDerivedRequirement ex:req_UncertaintyAwareness ;
    efr:hasDerivedRequirement ex:req_ProvenanceAwareness .

ex:rule_GoalOrientation a efr:RequirementDerivationRule ;
    efr:targetsFacet wcmkf:GoalOrientation ;
    efr:severityFloor "0.60"^^xsd:decimal ;
    efr:domainBaseWeight "0.80"^^xsd:decimal .

ex:req_GoalOrientation a efr:DerivedFacetRequirement ;
    wcmkf:requiresFacet wcmkf:GoalOrientation ;
    wcmkf:minimumRequiredLevel "0.72"^^xsd:decimal ;
    wcmkf:hasWeight "0.80"^^xsd:decimal ;
    efr:baseRequiredLevel "0.68"^^xsd:decimal ;
    efr:derivedWeight "0.80"^^xsd:decimal ;
    efr:prudentialDelta "0.04"^^xsd:decimal ;
    efr:priorityTier efr:PRIORITY_SUPPORTING ;
    efr:derivedByRule ex:rule_GoalOrientation .

