ex:case_health_triage a eth:EthicalCase ;
    eth:hasNormalizedRiskScore "0.82"^^xsd:decimal ;
    eth:hasPrudentialFlag true ;
    eth:hasDataSensitivity "sensitive" ;
    eth:hasHumanImpact "high" ;
    eth:hasIrreversibility "medium" ;
    eth:hasDomain efr:health_domain ;
    eth:hasRiskBand efr:SEVERITY_CRITICAL .

