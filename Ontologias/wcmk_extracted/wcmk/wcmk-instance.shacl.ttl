@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix arch: <https://example.org/eth2/arch#> .

arch:WcmkInstanceShape a sh:NodeShape ;
  sh:targetClass arch:WCMKInstance ;
  sh:property [ sh:path arch:instanceId ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:linkedProfileId ; sh:minCount 1 ; sh:datatype xsd:string ] .
