sh:NormConflictShape a sh:NodeShape ; sh:targetClass eth:NormConflict ;
  sh:property [ sh:path eth:firstNorm ; sh:minCount 1 ; sh:maxCount 1 ; sh:class eth:Norm ] ,
              [ sh:path eth:secondNorm ; sh:minCount 1 ; sh:maxCount 1 ; sh:class eth:Norm ] ,
