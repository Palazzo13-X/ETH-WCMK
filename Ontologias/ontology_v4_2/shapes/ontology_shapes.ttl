          [ sh:path eth:conflictPriority ; sh:minCount 1 ] ) .

sh:DelegationShape a sh:NodeShape ; sh:targetClass eth:Agent ;
  sh:property [ sh:path eth:agentId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
              [ sh:path eth:personaType ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
              [ sh:path eth:agentLayer ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:in ( eth:Layer_model eth:Layer_system eth:Layer_operator ) ] ,
              [ sh:path eth:attainmentFactorW ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive "0.0"^^xsd:double ;
                sh:maxInclusive "2.0"^^xsd:double ] ,
              [ sh:path eth:attainmentFactorC ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive "0.0"^^xsd:double ;
                sh:maxInclusive "2.0"^^xsd:double ] ,
              [ sh:path eth:attainmentFactorM ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive "0.0"^^xsd:double ;
                sh:maxInclusive "2.0"^^xsd:double ] ,
              [ sh:path eth:attainmentFactorK ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive "0.0"^^xsd:double ;
                sh:maxInclusive "2.0"^^xsd:double ] ,
              [ sh:path eth:jitter ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive "-0.5"^^xsd:double ;
                sh:maxInclusive "0.5"^^xsd:double ] ,
              [ sh:path eth:confidenceMean ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive "0.0"^^xsd:double ;
                sh:maxInclusive "1.0"^^xsd:double ] ,
              [ sh:path eth:fallbackPolicy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class eth:FallbackPolicy ] .

sh:ChainLinkShape a sh:NodeShape ; sh:targetClass eth:ChainLink ;
  sh:property [ sh:path eth:delegatingAgent ; sh:minCount 1 ; sh:maxCount 1 ; sh:class eth:Agent ] ,
              [ sh:path eth:delegateAgent ; sh:minCount 1 ; sh:maxCount 1 ; sh:class eth:Agent ] ,
              [ sh:path eth:delegatedPillar ; sh:minCount 0 ; sh:maxCount 4 ; sh:class eth:Pillar ] ,
              [ sh:path eth:delegationConsistent ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] .

sh:DelegationChainShape a sh:NodeShape ; sh:targetClass eth:DelegationChain ;
  sh:property [ sh:path eth:chainRoot ; sh:minCount 1 ; sh:maxCount 1 ; sh:class eth:Agent ] ,
              [ sh:path eth:delegationChainOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class eth:EthicalCase ] ,
              [ sh:path eth:chainLink ; sh:minCount 1 ] ,
              [ sh:path eth:fallbackForChain ; sh:minCount 1 ; sh:maxCount 1 ; sh:class eth:FallbackPolicy ] .

sh:ConfrontationChainShape a sh:NodeShape ; sh:targetClass eth:ConfrontationChain ;
  sh:property [ sh:path eth:weakestLinkLayer ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:in ( eth:Layer_model eth:Layer_system eth:Layer_operator ) ] ,
              [ sh:path eth:chainDecision ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:in ( eth:Decision_ABSTAIN eth:Decision_PROHIBIT eth:Decision_REVIEW_REQUIRED
                        eth:Decision_ALLOW_WITH_GUARDS eth:Decision_ALLOW ) ] ,
              [ sh:path eth:chainAdequacyLow ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive "0.0"^^xsd:double ;
                sh:maxInclusive "1.0"^^xsd:double ] ,
              [ sh:path eth:chainResidualRisk ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive "0.0"^^xsd:double ] ,
              [ sh:path eth:layerResult ; sh:minCount 3 ] ,
              [ sh:path eth:fallbackForChain ; sh:minCount 1 ; sh:maxCount 1 ; sh:class eth:FallbackPolicy ] .

sh:DriftProfileShape a sh:NodeShape ; sh:targetClass eth:DriftProfile ;
  sh:property [ sh:path eth:driftPillar ; sh:minCount 1 ; sh:maxCount 1 ; sh:class eth:Pillar ] ,
              [ sh:path eth:driftRate ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive "-1.0"^^xsd:double ;
                sh:maxInclusive "1.0"^^xsd:double ] ,
              [ sh:path eth:driftSteps ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ,
              [ sh:path eth:observedFlips ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] .
