eth:hysteresis_rule a eth:Rule ; rdfs:label "decision hysteresis (E13d)" ;
  eth:ruleStatement "A verdict never becomes more permissive unless the pessimistic adequacy is at least hysteresis above the case bar; becoming stricter is always allowed." ;
  eth:formalExpression "if verdict != previous and perm(verdict) > perm(previous) and Aa_low < bar + hysteresis then verdict = previous" ;
