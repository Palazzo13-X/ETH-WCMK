eth:rule_weakest_link a eth:Rule ; rdfs:label "weakest-link rule (E28)" ;
  eth:ruleStatement "The verdict of a layered agency is the verdict of its weakest link: the layer with the lowest pessimistic adequacy. Each layer keeps its own adequacy and residual risk, and the chain reports the maximum residual risk over the layers." ;
  eth:formalExpression "Aa_chain = min_i Aa_low(i) ; D_chain = D(argmin_i Aa_low(i)) ; R_r_chain = max_i R_r(i)" ;
  eth:appliesToClass eth:ConfrontationChain .
eth:rule_delegation_no_forbidden_duty a eth:Rule ; rdfs:label "no agent may be delegated a duty it is forbidden to perform" ;
  eth:ruleStatement "A delegation step that transfers the pillar of a duty to an agent subject to a prohibition on that pillar is invalid unless a resolution strategy explicitly overrides it." ;
  eth:formalExpression "forall l in ChainLink: delegate(l).forbiddenPillar intersect delegatedPillar(l) = empty or overrideStrategy(l) exists" ;
  eth:appliesToClass eth:ChainLink .
