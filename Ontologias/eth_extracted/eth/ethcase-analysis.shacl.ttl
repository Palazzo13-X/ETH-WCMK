@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix arch: <https://example.org/eth2/arch#> .

arch:EthcaseAnalysisShape a sh:NodeShape ;
  sh:targetClass arch:AnalysisBundle ;
  sh:property [ sh:path arch:analysisId ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:linkedCaseId ; sh:minCount 1 ; sh:datatype xsd:string ] .
