eth:ontology_v4 a owl:Ontology ; owl:versionIRI <https://ethwcmk.org/ontology#v4_0_0> ;
  owl:version "4.0.0" ; rdfs:label "ETH-WCMK formal ontology v4" ;
  rdfs:comment "Generated from the executable core: every declared number is the number the Python core uses. OWL structure is real (subClassOf, disjointWith, FunctionalProperty, TransitiveProperty, domain/range on every property)." .

# ---------------------------------------------------------------- class tree ----
eth:Entity a owl:Class ; rdfs:label "Entity" .
eth:Entity rdfs:comment "root of every declared individual" .
eth:Context a owl:Class ; rdfs:label "Context" .
eth:Context rdfs:subClassOf eth:Entity ; rdfs:comment "a contextual factor the case carries: pillar, band, horizon, domain" .
eth:Pillar a owl:Class ; rdfs:label "Pillar" .
eth:Pillar rdfs:subClassOf eth:Context ; rdfs:comment "one of the four independent agent magnitudes" .
eth:PillarW a owl:Class ; rdfs:label "PillarW" .
eth:PillarW rdfs:subClassOf eth:Pillar ; rdfs:comment "Want / intention pillar" .
eth:PillarC a owl:Class ; rdfs:label "PillarC" .
eth:PillarC rdfs:subClassOf eth:Pillar ; rdfs:comment "Can / capability pillar" .
eth:PillarM a owl:Class ; rdfs:label "PillarM" .
eth:PillarM rdfs:subClassOf eth:Pillar ; rdfs:comment "Must / obligation pillar" .
eth:PillarK a owl:Class ; rdfs:label "PillarK" .
eth:PillarK rdfs:subClassOf eth:Pillar ; rdfs:comment "Know / knowledge pillar" .
eth:Domain a owl:Class ; rdfs:label "Domain" .
eth:Domain rdfs:subClassOf eth:Context ; rdfs:comment "one of the 13 reference domains" .
eth:SeverityBand a owl:Class ; rdfs:label "SeverityBand" .
eth:SeverityBand rdfs:subClassOf eth:Context ; rdfs:comment "severity band of the case" .
eth:SeverityLow a owl:Class ; rdfs:label "SeverityLow" .
eth:SeverityLow rdfs:subClassOf eth:SeverityBand ; rdfs:comment "" .
eth:SeverityMedium a owl:Class ; rdfs:label "SeverityMedium" .
eth:SeverityMedium rdfs:subClassOf eth:SeverityBand ; rdfs:comment "" .
eth:SeverityHigh a owl:Class ; rdfs:label "SeverityHigh" .
eth:SeverityHigh rdfs:subClassOf eth:SeverityBand ; rdfs:comment "" .
eth:SeverityCritical a owl:Class ; rdfs:label "SeverityCritical" .
eth:SeverityCritical rdfs:subClassOf eth:SeverityBand ; rdfs:comment "" .
eth:PrudentialMode a owl:Class ; rdfs:label "PrudentialMode" .
eth:PrudentialMode rdfs:subClassOf eth:Context ; rdfs:comment "prudential posture declared by the institution" .
eth:PrudentialStandard a owl:Class ; rdfs:label "PrudentialStandard" .
eth:PrudentialStandard rdfs:subClassOf eth:PrudentialMode ; rdfs:comment "" .
eth:PrudentialElevated a owl:Class ; rdfs:label "PrudentialElevated" .
eth:PrudentialElevated rdfs:subClassOf eth:PrudentialMode ; rdfs:comment "" .
eth:PrudentialMaximum a owl:Class ; rdfs:label "PrudentialMaximum" .
eth:PrudentialMaximum rdfs:subClassOf eth:PrudentialMode ; rdfs:comment "" .
eth:Reversibility a owl:Class ; rdfs:label "Reversibility" .
eth:Reversibility rdfs:subClassOf eth:Context ; rdfs:comment "reversibility of the decision" .
eth:Reversible a owl:Class ; rdfs:label "Reversible" .
eth:Reversible rdfs:subClassOf eth:Reversibility ; rdfs:comment "" .
eth:PartiallyIrreversible a owl:Class ; rdfs:label "PartiallyIrreversible" .
eth:PartiallyIrreversible rdfs:subClassOf eth:Reversibility ; rdfs:comment "" .
eth:Irreversible a owl:Class ; rdfs:label "Irreversible" .
eth:Irreversible rdfs:subClassOf eth:Reversibility ; rdfs:comment "" .
eth:TemporalHorizon a owl:Class ; rdfs:label "TemporalHorizon" .
eth:TemporalHorizon rdfs:subClassOf eth:Context ; rdfs:comment "horizon over which consequences materialise" .
eth:HorizonImmediate a owl:Class ; rdfs:label "HorizonImmediate" .
eth:HorizonImmediate rdfs:subClassOf eth:TemporalHorizon ; rdfs:comment "" .
eth:HorizonShort a owl:Class ; rdfs:label "HorizonShort" .
eth:HorizonShort rdfs:subClassOf eth:TemporalHorizon ; rdfs:comment "" .
eth:HorizonMedium a owl:Class ; rdfs:label "HorizonMedium" .
eth:HorizonMedium rdfs:subClassOf eth:TemporalHorizon ; rdfs:comment "" .
eth:HorizonLong a owl:Class ; rdfs:label "HorizonLong" .
eth:HorizonLong rdfs:subClassOf eth:TemporalHorizon ; rdfs:comment "" .
eth:AggregationPolicy a owl:Class ; rdfs:label "AggregationPolicy" .
eth:AggregationPolicy rdfs:subClassOf eth:Context ; rdfs:comment "how a facet contributes to its pillars (E20-E23)" .
eth:CriticalityStatement a owl:Class ; rdfs:label "CriticalityStatement" .
eth:CriticalityStatement rdfs:subClassOf eth:Entity ; rdfs:comment "reified criticality of a facet in one domain" .
eth:LatticeSlot a owl:Class ; rdfs:label "LatticeSlot" .
eth:LatticeSlot rdfs:subClassOf eth:Entity ; rdfs:comment "a relational index of the 3-simplex face lattice (15 slots)" .
eth:StructuralTerm a owl:Class ; rdfs:label "StructuralTerm" .
eth:StructuralTerm rdfs:subClassOf eth:Entity ; rdfs:comment "D, S2, S3, S4: the structural terms of Eq. 10" .
eth:Facet a owl:Class ; rdfs:label "Facet" .
eth:Facet rdfs:subClassOf eth:Entity ; rdfs:comment "one of the 28 facets of the registry" .
eth:WantFacet a owl:Class ; rdfs:label "WantFacet" .
eth:WantFacet rdfs:subClassOf eth:Facet ; rdfs:comment "facet whose primary pillar is W" .
eth:CanFacet a owl:Class ; rdfs:label "CanFacet" .
eth:CanFacet rdfs:subClassOf eth:Facet ; rdfs:comment "facet whose primary pillar is C" .
eth:MustFacet a owl:Class ; rdfs:label "MustFacet" .
eth:MustFacet rdfs:subClassOf eth:Facet ; rdfs:comment "facet whose primary pillar is M" .
eth:KnowFacet a owl:Class ; rdfs:label "KnowFacet" .
eth:KnowFacet rdfs:subClassOf eth:Facet ; rdfs:comment "facet whose primary pillar is K" .
eth:GuardedFacet a owl:Class ; rdfs:label "GuardedFacet" .
eth:GuardedFacet rdfs:subClassOf eth:Facet ; rdfs:comment "facet carrying a hard guard floor" .
eth:Calibration a owl:Class ; rdfs:label "Calibration" .
eth:Calibration rdfs:subClassOf eth:Entity ; rdfs:comment "the declared quantitative parameters of the model" .
eth:EthicalCase a owl:Class ; rdfs:label "EthicalCase" .
eth:EthicalCase rdfs:subClassOf eth:Entity ; rdfs:comment "a case: a situation, an agent profile and the duties that apply" .
eth:Profile a owl:Class ; rdfs:label "Profile" .
eth:Profile rdfs:subClassOf eth:Entity ; rdfs:comment "an agent profile: observed facet levels and observation confidence" .
eth:FacetObservation a owl:Class ; rdfs:label "FacetObservation" .
eth:FacetObservation rdfs:subClassOf eth:Entity ; rdfs:comment "one observed facet level with its confidence" .
eth:FacetRequirement a owl:Class ; rdfs:label "FacetRequirement" .
eth:FacetRequirement rdfs:subClassOf eth:Entity ; rdfs:comment "one canonical requirement of a facet for a case (E27)" .
eth:Confrontation a owl:Class ; rdfs:label "Confrontation" .
eth:Confrontation rdfs:subClassOf eth:Entity ; rdfs:comment "the arithmetic run of a case against a profile; its values are exactly the numbers produced by core.confront" .
eth:GuardFailure a owl:Class ; rdfs:label "GuardFailure" .
eth:GuardFailure rdfs:subClassOf eth:Entity ; rdfs:comment "a hard guard breached in a confrontation" .
eth:Stakeholder a owl:Class ; rdfs:label "Stakeholder" .
eth:Stakeholder rdfs:subClassOf eth:Entity ; rdfs:comment "a party affected by the decision" .
eth:Consequence a owl:Class ; rdfs:label "Consequence" .
eth:Consequence rdfs:subClassOf eth:Entity ; rdfs:comment "a plausible consequence of following the agent" .
eth:Evidence a owl:Class ; rdfs:label "Evidence" .
eth:Evidence rdfs:subClassOf eth:Entity ; rdfs:comment "evidence present or absent in the record" .
eth:Vulnerability a owl:Class ; rdfs:label "Vulnerability" .
eth:Vulnerability rdfs:subClassOf eth:Entity ; rdfs:comment "a structural disadvantage of the affected group" .
eth:Decision a owl:Class ; rdfs:label "Decision" .
eth:Decision rdfs:subClassOf eth:Entity ; rdfs:comment "a state of the decision ladder" .
eth:DriftProfile a owl:Class ; rdfs:label "DriftProfile" .
eth:DriftProfile rdfs:subClassOf eth:Entity ; rdfs:comment "a temporal drift scenario used by the hysteresis battery" .
eth:NormativeInstrument a owl:Class ; rdfs:label "NormativeInstrument" .
eth:NormativeInstrument rdfs:subClassOf eth:Entity ; rdfs:comment "an external normative instrument (GDPR, Belmont, ...)" .
eth:Norm a owl:Class ; rdfs:label "Norm" .
eth:Norm rdfs:subClassOf eth:Entity ; rdfs:comment "a norm: an obligation, a prohibition or a permission" .
eth:Obligation a owl:Class ; rdfs:label "Obligation" .
eth:Obligation rdfs:subClassOf eth:Norm ; rdfs:comment "a duty the agent must meet" .
eth:Prohibition a owl:Class ; rdfs:label "Prohibition" .
eth:Prohibition rdfs:subClassOf eth:Norm ; rdfs:comment "a duty the agent must not breach" .
eth:Permission a owl:Class ; rdfs:label "Permission" .
eth:Permission rdfs:subClassOf eth:Norm ; rdfs:comment "an allowed course of action, defeasible against duties" .
eth:Defeasibility a owl:Class ; rdfs:label "Defeasibility" .
eth:Defeasibility rdfs:subClassOf eth:Entity ; rdfs:comment "the condition under which a norm stops applying" .
eth:PriorityEngine a owl:Class ; rdfs:label "PriorityEngine" .
eth:PriorityEngine rdfs:subClassOf eth:Entity ; rdfs:comment "the ranking rule used to break a norm conflict" .
eth:ResolutionStrategy a owl:Class ; rdfs:label "ResolutionStrategy" .
eth:ResolutionStrategy rdfs:subClassOf eth:Entity ; rdfs:comment "the operational strategy that settles a conflict" .
eth:NormConflict a owl:Class ; rdfs:label "NormConflict" .
eth:NormConflict rdfs:subClassOf eth:Entity ; rdfs:comment "a concrete conflict between two typed norms" .
eth:ConflictPattern a owl:Class ; rdfs:label "ConflictPattern" .
eth:ConflictPattern rdfs:subClassOf eth:Context ; rdfs:comment "the abstract shape of a norm conflict" .
eth:Agent a owl:Class ; rdfs:label "Agent" .
eth:Agent rdfs:subClassOf eth:Entity ; rdfs:comment "an actor evaluated by the model" .
eth:AgentLayer a owl:Class ; rdfs:label "AgentLayer" .
eth:AgentLayer rdfs:subClassOf eth:Context ; rdfs:comment "model / system / operator layer of agency" .
eth:DelegationChain a owl:Class ; rdfs:label "DelegationChain" .
eth:DelegationChain rdfs:subClassOf eth:Entity ; rdfs:comment "a delegation chain between agents (transitive)" .
eth:ChainLink a owl:Class ; rdfs:label "ChainLink" .
eth:ChainLink rdfs:subClassOf eth:Entity ; rdfs:comment "one delegation step of a chain" .
eth:FallbackPolicy a owl:Class ; rdfs:label "FallbackPolicy" .
eth:FallbackPolicy rdfs:subClassOf eth:Entity ; rdfs:comment "what the system does when a duty cannot be met" .
eth:ConfrontationChain a owl:Class ; rdfs:label "ConfrontationChain" .
eth:ConfrontationChain rdfs:subClassOf eth:Entity ; rdfs:comment "layered agency evaluated at its weakest link (E28)" .
eth:ChainLayerResult a owl:Class ; rdfs:label "ChainLayerResult" .
eth:ChainLayerResult rdfs:subClassOf eth:Entity ; rdfs:comment "the result of one layer inside a chain" .
eth:Rule a owl:Class ; rdfs:label "Rule" .
eth:Rule rdfs:subClassOf eth:Entity ; rdfs:comment "a declared rule of the formal model" .

# four pillars are mutually exclusive individuals
eth:PillarW owl:disjointWith eth:PillarC .
eth:PillarW owl:disjointWith eth:PillarM .
eth:PillarW owl:disjointWith eth:PillarK .
eth:PillarC owl:disjointWith eth:PillarM .
eth:PillarC owl:disjointWith eth:PillarK .
eth:PillarM owl:disjointWith eth:PillarK .
# the four severity bands are mutually exclusive
eth:SeverityLow owl:disjointWith eth:SeverityMedium .
eth:SeverityLow owl:disjointWith eth:SeverityHigh .
eth:SeverityLow owl:disjointWith eth:SeverityCritical .
eth:SeverityMedium owl:disjointWith eth:SeverityHigh .
eth:SeverityMedium owl:disjointWith eth:SeverityCritical .
eth:SeverityHigh owl:disjointWith eth:SeverityCritical .
# the three prudential postures are mutually exclusive
eth:PrudentialStandard owl:disjointWith eth:PrudentialElevated .
eth:PrudentialStandard owl:disjointWith eth:PrudentialMaximum .
eth:PrudentialElevated owl:disjointWith eth:PrudentialMaximum .
# the four temporal horizons are mutually exclusive
eth:HorizonImmediate owl:disjointWith eth:HorizonShort .
eth:HorizonImmediate owl:disjointWith eth:HorizonMedium .
eth:HorizonImmediate owl:disjointWith eth:HorizonLong .
eth:HorizonShort owl:disjointWith eth:HorizonMedium .
eth:HorizonShort owl:disjointWith eth:HorizonLong .
eth:HorizonMedium owl:disjointWith eth:HorizonLong .
# an obligation cannot be a prohibition and cannot be a permission
eth:Obligation owl:disjointWith eth:Prohibition .
eth:Obligation owl:disjointWith eth:Permission .
eth:Prohibition owl:disjointWith eth:Permission .

# ------------------------------------------------------ individuals: pillars ----
eth:pillar_W a eth:Pillar, eth:PillarW ; rdfs:label "W" ; eth:latticeIndex 1 ; eth:faceLatticeSlot eth:slot_vW .
eth:pillar_C a eth:Pillar, eth:PillarC ; rdfs:label "C" ; eth:latticeIndex 2 ; eth:faceLatticeSlot eth:slot_vC .
eth:pillar_M a eth:Pillar, eth:PillarM ; rdfs:label "M" ; eth:latticeIndex 3 ; eth:faceLatticeSlot eth:slot_vM .
eth:pillar_K a eth:Pillar, eth:PillarK ; rdfs:label "K" ; eth:latticeIndex 4 ; eth:faceLatticeSlot eth:slot_vK .

# domains
eth:domain_SA a eth:Domain ; rdfs:label "Health" ; eth:domainCode "SA" .
eth:domain_JS a eth:Domain ; rdfs:label "Justice and security" ; eth:domainCode "JS" .
eth:domain_IC a eth:Domain ; rdfs:label "Critical infrastructure" ; eth:domainCode "IC" .
eth:domain_FI a eth:Domain ; rdfs:label "Finance" ; eth:domainCode "FI" .
eth:domain_PD a eth:Domain ; rdfs:label "Privacy and data" ; eth:domainCode "PD" .
eth:domain_GP a eth:Domain ; rdfs:label "Public governance" ; eth:domainCode "GP" .
eth:domain_IM a eth:Domain ; rdfs:label "Information and media" ; eth:domainCode "IM" .
eth:domain_ED a eth:Domain ; rdfs:label "Education" ; eth:domainCode "ED" .
eth:domain_TB a eth:Domain ; rdfs:label "Labour" ; eth:domainCode "TB" .
eth:domain_MA a eth:Domain ; rdfs:label "Environment and energy" ; eth:domainCode "MA" .
eth:domain_TS a eth:Domain ; rdfs:label "Transport and mobility" ; eth:domainCode "TS" .
eth:domain_RS a eth:Domain ; rdfs:label "Research and science" ; eth:domainCode "RS" .
eth:domain_DS a eth:Domain ; rdfs:label "Digital security" ; eth:domainCode "DS" .

# aggregation policies (implemented in core.project, not decorative)
eth:Policy_weighted_mean a eth:AggregationPolicy ; rdfs:label "weighted_mean" .
eth:Policy_guarded_weighted_mean a eth:AggregationPolicy ; rdfs:label "guarded_weighted_mean" .
eth:Policy_threshold_override a eth:AggregationPolicy ; rdfs:label "threshold_override" .
eth:Policy_uncertainty_penalized_mean a eth:AggregationPolicy ; rdfs:label "uncertainty_penalized_mean" .

# ----------------------------------------- face-lattice slots and terms ----
eth:term_D a eth:StructuralTerm ; rdfs:label "D: weighted pillar deficit" ; eth:termCoefficient 1.0 .
eth:term_S2 a eth:StructuralTerm ; rdfs:label "S2: pairwise (edge) joint deficit" ; eth:termCoefficient 0.12 .
eth:term_S3 a eth:StructuralTerm ; rdfs:label "S3: triple (face) joint deficit" ; eth:termCoefficient 0.05 .
eth:term_S4 a eth:StructuralTerm ; rdfs:label "S4: cell (4-way) joint deficit, min deficit in v12" ; eth:termCoefficient 0.03 .
eth:slot_cell a eth:LatticeSlot ; eth:slotKind "cell" ; eth:incidence "W C M K" ; eth:belongsToTerm eth:term_S4 ; eth:structuralWeight "1"^^xsd:double ; eth:latticeIndex 15 .
eth:slot_eWC a eth:LatticeSlot ; eth:slotKind "edge" ; eth:incidence "W C" ; eth:belongsToTerm eth:term_S2 ; eth:structuralWeight "0.166666666667"^^xsd:double ; eth:latticeIndex 5 .
eth:slot_eWM a eth:LatticeSlot ; eth:slotKind "edge" ; eth:incidence "W M" ; eth:belongsToTerm eth:term_S2 ; eth:structuralWeight "0.166666666667"^^xsd:double ; eth:latticeIndex 6 .
eth:slot_eWK a eth:LatticeSlot ; eth:slotKind "edge" ; eth:incidence "W K" ; eth:belongsToTerm eth:term_S2 ; eth:structuralWeight "0.166666666667"^^xsd:double ; eth:latticeIndex 7 .
eth:slot_eCM a eth:LatticeSlot ; eth:slotKind "edge" ; eth:incidence "C M" ; eth:belongsToTerm eth:term_S2 ; eth:structuralWeight "0.166666666667"^^xsd:double ; eth:latticeIndex 8 .
eth:slot_eCK a eth:LatticeSlot ; eth:slotKind "edge" ; eth:incidence "C K" ; eth:belongsToTerm eth:term_S2 ; eth:structuralWeight "0.166666666667"^^xsd:double ; eth:latticeIndex 9 .
eth:slot_eMK a eth:LatticeSlot ; eth:slotKind "edge" ; eth:incidence "M K" ; eth:belongsToTerm eth:term_S2 ; eth:structuralWeight "0.166666666667"^^xsd:double ; eth:latticeIndex 10 .
eth:slot_fWCM a eth:LatticeSlot ; eth:slotKind "face" ; eth:incidence "W C M" ; eth:belongsToTerm eth:term_S3 ; eth:structuralWeight "0.25"^^xsd:double ; eth:latticeIndex 11 .
eth:slot_fWCK a eth:LatticeSlot ; eth:slotKind "face" ; eth:incidence "W C K" ; eth:belongsToTerm eth:term_S3 ; eth:structuralWeight "0.25"^^xsd:double ; eth:latticeIndex 12 .
eth:slot_fWMK a eth:LatticeSlot ; eth:slotKind "face" ; eth:incidence "W M K" ; eth:belongsToTerm eth:term_S3 ; eth:structuralWeight "0.25"^^xsd:double ; eth:latticeIndex 13 .
eth:slot_fCMK a eth:LatticeSlot ; eth:slotKind "face" ; eth:incidence "C M K" ; eth:belongsToTerm eth:term_S3 ; eth:structuralWeight "0.25"^^xsd:double ; eth:latticeIndex 14 .

# every pillar vertex slot carries the pillar salience lambda: the term D is the sum of the four vertex slots, each term sums to exactly 1
eth:slot_vW a eth:LatticeSlot ; eth:slotKind "vertex" ; eth:incidence "W" ; eth:belongsToTerm eth:term_D ; eth:structuralWeight "0.3"^^xsd:double ; eth:latticeIndex 1 .
eth:slot_vC a eth:LatticeSlot ; eth:slotKind "vertex" ; eth:incidence "C" ; eth:belongsToTerm eth:term_D ; eth:structuralWeight "0.25"^^xsd:double ; eth:latticeIndex 2 .
eth:slot_vM a eth:LatticeSlot ; eth:slotKind "vertex" ; eth:incidence "M" ; eth:belongsToTerm eth:term_D ; eth:structuralWeight "0.25"^^xsd:double ; eth:latticeIndex 3 .
eth:slot_vK a eth:LatticeSlot ; eth:slotKind "vertex" ; eth:incidence "K" ; eth:belongsToTerm eth:term_D ; eth:structuralWeight "0.2"^^xsd:double ; eth:latticeIndex 4 .
eth:term_D eth:termWeightSum 1.0 .
eth:term_S2 eth:termWeightSum 1.0 .
eth:term_S3 eth:termWeightSum 1.0 .
eth:term_S4 eth:termWeightSum 1.0 .
eth:term_D eth:hasSlot eth:slot_vW, eth:slot_vC, eth:slot_vM, eth:slot_vK .
eth:term_S2 eth:hasSlot eth:slot_eWC, eth:slot_eWM, eth:slot_eWK, eth:slot_eCM, eth:slot_eCK, eth:slot_eMK .
eth:term_S3 eth:hasSlot eth:slot_fWCM, eth:slot_fWCK, eth:slot_fWMK, eth:slot_fCMK .
eth:term_S4 eth:hasSlot eth:slot_cell .

# ------------------------------------------------------- declared properties ----
eth:latticeIndex a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "latticeIndex" ; rdfs:domain eth:LatticeSlot ; rdfs:range xsd:integer ; rdfs:comment "index of the slot in the lattice" .
eth:domainCode a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "domainCode" ; rdfs:domain eth:Domain ; rdfs:range xsd:string ; rdfs:comment "two-letter domain code" .
eth:faceLatticeSlot a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "faceLatticeSlot" ; rdfs:domain eth:Pillar ; rdfs:range eth:LatticeSlot ; rdfs:comment "the vertex slot of a pillar" .
eth:code a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "code" ; rdfs:domain eth:Facet ; rdfs:range xsd:string ; rdfs:comment "facet code" .
eth:betaW a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "betaW" ; rdfs:domain eth:Facet ; rdfs:range xsd:double ; rdfs:comment "share of the facet carried by the Want pillar" .
eth:betaC a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "betaC" ; rdfs:domain eth:Facet ; rdfs:range xsd:double ; rdfs:comment "share carried by Can" .
eth:betaM a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "betaM" ; rdfs:domain eth:Facet ; rdfs:range xsd:double ; rdfs:comment "share carried by Must" .
eth:betaK a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "betaK" ; rdfs:domain eth:Facet ; rdfs:range xsd:double ; rdfs:comment "share carried by Know" .
eth:betaSum a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "betaSum" ; rdfs:domain eth:Facet ; rdfs:range xsd:double ; rdfs:comment "derived invariant: the four betas must sum to 1 (R1)" .
eth:nPillars a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "nPillars" ; rdfs:domain eth:Facet ; rdfs:range xsd:integer ; rdfs:comment "number of pillars a facet touches (R2)" .
eth:minNonZeroBeta a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "minNonZeroBeta" ; rdfs:domain eth:Facet ; rdfs:range xsd:double ; rdfs:comment "derived invariant: smallest non-zero beta (R3)" .
eth:primaryPillar a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "primaryPillar" ; rdfs:domain eth:Facet ; rdfs:range eth:Pillar ; rdfs:comment "pillar holding the largest beta" .
eth:sharesPillar a owl:ObjectProperty ; rdfs:label "sharesPillar" ; rdfs:domain eth:Facet ; rdfs:range eth:Pillar ; rdfs:comment "pillar the facet contributes to" .
eth:aggregationPolicy a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "aggregationPolicy" ; rdfs:domain eth:Facet ; rdfs:range eth:AggregationPolicy ; rdfs:comment "policy applied in project()" .
eth:hardGuard a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "hardGuard" ; rdfs:domain eth:Facet ; rdfs:range xsd:boolean ; rdfs:comment "the facet carries a hard guard floor" .
eth:guardMin a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "guardMin" ; rdfs:domain eth:Facet ; rdfs:range xsd:double ; rdfs:comment "guard floor (R4: positive when guard is declared)" .
eth:observable a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "observable" ; rdfs:domain eth:Facet ; rdfs:range xsd:string ; rdfs:comment "the proxy that makes the facet measurable (R6)" .
eth:source a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "source" ; rdfs:domain eth:Facet ; rdfs:range xsd:string ; rdfs:comment "catalog or new" .
eth:criticalityStatement a owl:ObjectProperty ; rdfs:label "criticalityStatement" ; rdfs:domain eth:Facet ; rdfs:range eth:CriticalityStatement ; rdfs:comment "reified criticality of the facet in a domain" .
eth:criticalityDomain a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "criticalityDomain" ; rdfs:domain eth:CriticalityStatement ; rdfs:range eth:Domain ; rdfs:comment "domain of a reified criticality statement" .
eth:criticalityLevel a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "criticalityLevel" ; rdfs:domain eth:CriticalityStatement ; rdfs:range xsd:integer ; rdfs:comment "2, 3 or 4" .

# ---- properties of the instantiated corpus ----
eth:slotKind a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "slotKind" ; rdfs:domain eth:LatticeSlot ; rdfs:range xsd:string ; rdfs:comment "vertex | edge | face | cell" .
eth:incidence a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "incidence" ; rdfs:domain eth:LatticeSlot ; rdfs:range xsd:string ; rdfs:comment "pillars the slot relates" .
eth:belongsToTerm a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "belongsToTerm" ; rdfs:domain eth:LatticeSlot ; rdfs:range eth:StructuralTerm ; rdfs:comment "which structural term the weight belongs to" .
eth:structuralWeight a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "structuralWeight" ; rdfs:domain eth:LatticeSlot ; rdfs:range xsd:double ; rdfs:comment "weight of the slot inside its term" .
eth:usesLattice a owl:ObjectProperty ; rdfs:label "usesLattice" ; rdfs:domain eth:Calibration ; rdfs:range eth:StructuralTerm ; rdfs:comment "structural terms used by this calibration" .
eth:calibrationSource a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "calibrationSource" ; rdfs:domain eth:Calibration ; rdfs:range xsd:string ; rdfs:comment "artifact the parameters come from" .
eth:caseId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "caseId" ; rdfs:domain eth:EthicalCase ; rdfs:range xsd:string ; rdfs:comment "corpus identifier of the case" .
eth:corpusLayer a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "corpusLayer" ; rdfs:domain eth:EthicalCase ; rdfs:range xsd:string ; rdfs:comment "A (quantitative stress) or B (semantic narrative)" .
eth:scenario a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "scenario" ; rdfs:domain eth:EthicalCase ; rdfs:range xsd:string ; rdfs:comment "the deployment scenario" .
eth:archetype a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "archetype" ; rdfs:domain eth:EthicalCase ; rdfs:range xsd:string ; rdfs:comment "design archetype of the case" .
eth:designIntent a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "designIntent" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:Decision ; rdfs:comment "the verdict the scenario was built to elicit" .
eth:domain a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "domain" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:Domain ; rdfs:comment "domain of the case" .
eth:severity a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "severity" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:SeverityBand ; rdfs:comment "severity band of the case" .
eth:prudentialMode a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "prudentialMode" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:PrudentialMode ; rdfs:comment "prudential posture" .
eth:reversibility a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "reversibility" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:Reversibility ; rdfs:comment "reversibility of the decision" .
eth:horizon a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "horizon" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:TemporalHorizon ; rdfs:comment "horizon of consequences" .
eth:conflictPattern a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "conflictPattern" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:ConflictPattern ; rdfs:comment "abstract pattern of the normative tension" .
eth:agentLayer a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "agentLayer" ; rdfs:domain eth:Entity ; rdfs:range eth:AgentLayer ; rdfs:comment "layer of agency of the evaluated actor" .
eth:epistemicUncertainty a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "epistemicUncertainty" ; rdfs:domain eth:EthicalCase ; rdfs:range xsd:double ; rdfs:comment "U_E: situational uncertainty" .
eth:consequenceMass a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "consequenceMass" ; rdfs:domain eth:EthicalCase ; rdfs:range xsd:double ; rdfs:comment "R_c: mass of the consequence" .
eth:exposureScale a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "exposureScale" ; rdfs:domain eth:EthicalCase ; rdfs:range xsd:double ; rdfs:comment "exposure: how many people are in the blast radius" .
eth:criticalPillar a owl:ObjectProperty ; rdfs:label "criticalPillar" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:Pillar ; rdfs:comment "pillar declared critical for this case" .
eth:criticalPillarDeclaredCount a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "criticalPillarDeclaredCount" ; rdfs:domain eth:EthicalCase ; rdfs:range xsd:integer ; rdfs:comment "number of declared critical-pillar slots (E27)" .
eth:normConflictStatus a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "normConflictStatus" ; rdfs:domain eth:EthicalCase ; rdfs:range xsd:string ; rdfs:comment "none | unresolved | resolved_by_priority" .
eth:evidenceConflict a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "evidenceConflict" ; rdfs:domain eth:EthicalCase ; rdfs:range xsd:boolean ; rdfs:comment "the record contains contradictory evidence" .
eth:hasNorm a owl:ObjectProperty ; rdfs:label "hasNorm" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:Norm ; rdfs:comment "norm engaged by the case" .
eth:hasObligation a owl:ObjectProperty ; rdfs:label "hasObligation" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:Obligation ; rdfs:comment "obligation engaged by the case" .
eth:hasProhibition a owl:ObjectProperty ; rdfs:label "hasProhibition" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:Prohibition ; rdfs:comment "prohibition engaged by the case" .
eth:hasPermission a owl:ObjectProperty ; rdfs:label "hasPermission" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:Permission ; rdfs:comment "permission engaged by the case" .
eth:hasNormConflict a owl:ObjectProperty ; rdfs:label "hasNormConflict" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:NormConflict ; rdfs:comment "concrete conflict attached to the case" .
eth:caseResolutionStrategy a owl:ObjectProperty ; rdfs:label "caseResolutionStrategy" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:ResolutionStrategy ; rdfs:comment "strategy that settles the conflicts attached to the case" .
eth:hasReviewBody a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "hasReviewBody" ; rdfs:domain eth:EthicalCase ; rdfs:range xsd:string ; rdfs:comment "the standing review body" .
eth:priorRecord a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "priorRecord" ; rdfs:domain eth:EthicalCase ; rdfs:range xsd:string ; rdfs:comment "institutional record in this area" .
eth:declaredObjective a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "declaredObjective" ; rdfs:domain eth:EthicalCase ; rdfs:range xsd:string ; rdfs:comment "declared purpose of the deployment" .
eth:operationalConstraint a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "operationalConstraint" ; rdfs:domain eth:EthicalCase ; rdfs:range xsd:string ; rdfs:comment "constraint on the operating conditions" .
eth:mitigationInPlace a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "mitigationInPlace" ; rdfs:domain eth:EthicalCase ; rdfs:range xsd:string ; rdfs:comment "mitigation already in place" .
eth:hasStakeholder a owl:ObjectProperty ; rdfs:label "hasStakeholder" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:Stakeholder ; rdfs:comment "party affected by the decision" .
eth:hasConsequence a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "hasConsequence" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:Consequence ; rdfs:comment "plausible consequence" .
eth:hasEvidence a owl:ObjectProperty ; rdfs:label "hasEvidence" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:Evidence ; rdfs:comment "piece of evidence in the record" .
eth:hasVulnerability a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "hasVulnerability" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:Vulnerability ; rdfs:comment "structural disadvantage of the affected group" .
eth:declaredProfile a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "declaredProfile" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:Profile ; rdfs:comment "the profile the corpus declares for the case" .
eth:hasRequirement a owl:ObjectProperty ; rdfs:label "hasRequirement" ; rdfs:domain eth:EthicalCase ; rdfs:range eth:FacetRequirement ; rdfs:comment "canonical requirement of a facet for the case" .
eth:stakeholderName a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "stakeholderName" ; rdfs:domain eth:Stakeholder ; rdfs:range xsd:string ; rdfs:comment "name of the affected party" .
eth:consentGiven a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "consentGiven" ; rdfs:domain eth:Stakeholder ; rdfs:range xsd:boolean ; rdfs:comment "whether the party consented" .
eth:affectedCount a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "affectedCount" ; rdfs:domain eth:Stakeholder ; rdfs:range xsd:integer ; rdfs:comment "ordinal rank of the stakeholder in the list" .
eth:consequenceText a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "consequenceText" ; rdfs:domain eth:Consequence ; rdfs:range xsd:string ; rdfs:comment "the consequence in natural language" .
eth:consequenceIrreversibility a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "consequenceIrreversibility" ; rdfs:domain eth:Consequence ; rdfs:range xsd:string ; rdfs:comment "reversibility class of the consequence" .
eth:consequenceHorizon a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "consequenceHorizon" ; rdfs:domain eth:Consequence ; rdfs:range xsd:string ; rdfs:comment "horizon over which it materialises" .
eth:evidenceText a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "evidenceText" ; rdfs:domain eth:Evidence ; rdfs:range xsd:string ; rdfs:comment "what the evidence says" .
eth:evidenceStatus a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "evidenceStatus" ; rdfs:domain eth:Evidence ; rdfs:range xsd:string ; rdfs:comment "present | absent | contested" .
eth:vulnerabilityText a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "vulnerabilityText" ; rdfs:domain eth:Vulnerability ; rdfs:range xsd:string ; rdfs:comment "the disadvantage in natural language" .
eth:vulnerabilityKind a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "vulnerabilityKind" ; rdfs:domain eth:Vulnerability ; rdfs:range xsd:string ; rdfs:comment "structural | procedural | epistemic | cognitive | dependency" .
eth:profileId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "profileId" ; rdfs:domain eth:Profile ; rdfs:range xsd:string ; rdfs:comment "identifier of the profile" .
eth:layerOfProfile a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "layerOfProfile" ; rdfs:domain eth:Profile ; rdfs:range eth:AgentLayer ; rdfs:comment "layer the profile belongs to" .
eth:coverage a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "coverage" ; rdfs:domain eth:Profile ; rdfs:range xsd:double ; rdfs:comment "share of the facets the profile covers" .
eth:basedOnAgent a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "basedOnAgent" ; rdfs:domain eth:Profile ; rdfs:range eth:Agent ; rdfs:comment "agent the profile describes" .
eth:hasObservation a owl:ObjectProperty ; rdfs:label "hasObservation" ; rdfs:domain eth:Profile ; rdfs:range eth:FacetObservation ; rdfs:comment "one observation of a facet" .
eth:observedFacet a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "observedFacet" ; rdfs:domain eth:FacetObservation ; rdfs:range eth:Facet ; rdfs:comment "facet observed" .
eth:observedValue a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "observedValue" ; rdfs:domain eth:FacetObservation ; rdfs:range xsd:double ; rdfs:comment "level attained by the agent in that facet" .
eth:observationConfidence a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "observationConfidence" ; rdfs:domain eth:FacetObservation ; rdfs:range xsd:double ; rdfs:comment "confidence of the observation" .
eth:requirementFacet a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "requirementFacet" ; rdfs:domain eth:FacetRequirement ; rdfs:range eth:Facet ; rdfs:comment "facet the requirement applies to" .
eth:requirementValue a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "requirementValue" ; rdfs:domain eth:FacetRequirement ; rdfs:range xsd:double ; rdfs:comment "canonical requirement r_f (E27)" .
eth:confrontationId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "confrontationId" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:string ; rdfs:comment "identifier of the confrontation" .
eth:confrontationCase a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "confrontationCase" ; rdfs:domain eth:Confrontation ; rdfs:range eth:EthicalCase ; rdfs:comment "case confronted" .
eth:confrontationProfile a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "confrontationProfile" ; rdfs:domain eth:Confrontation ; rdfs:range eth:Profile ; rdfs:comment "profile confronted" .
eth:appliedCalibration a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "appliedCalibration" ; rdfs:domain eth:Confrontation ; rdfs:range eth:Calibration ; rdfs:comment "calibration used in the arithmetic" .
eth:levelW a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "levelW" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "projected level of the Want pillar" .
eth:levelC a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "levelC" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "projected level of the Can pillar" .
eth:levelM a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "levelM" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "projected level of the Must pillar" .
eth:levelK a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "levelK" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "projected level of the Know pillar" .
eth:requirementW a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "requirementW" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "projected requirement of the Want pillar" .
eth:requirementC a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "requirementC" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "projected requirement of the Can pillar" .
eth:requirementM a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "requirementM" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "projected requirement of the Must pillar" .
eth:requirementK a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "requirementK" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "projected requirement of the Know pillar" .
eth:deficitW a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "deficitW" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "d_W = max(0, q_W - l_W)" .
eth:deficitC a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "deficitC" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "d_C" .
eth:deficitM a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "deficitM" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "d_M" .
eth:deficitK a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "deficitK" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "d_K" .
eth:guardedDeficitW a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "guardedDeficitW" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "deficit measured on the guard-capped level" .
eth:guardedDeficitC a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "guardedDeficitC" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "guarded deficit of Can" .
eth:guardedDeficitM a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "guardedDeficitM" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "guarded deficit of Must" .
eth:guardedDeficitK a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "guardedDeficitK" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "guarded deficit of Know" .
eth:structuralTermS2 a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "structuralTermS2" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "pairwise joint deficit S2" .
eth:structuralTermS3 a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "structuralTermS3" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "triple joint deficit S3" .
eth:structuralTermS4 a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "structuralTermS4" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "cell joint deficit S4 = min deficit (v12)" .
eth:slackS3minusS4 a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "slackS3minusS4" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "derived coherence: S3 - S4 >= 0" .
eth:slackS2minusS3 a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "slackS2minusS3" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "derived coherence: S2 - S3 >= 0" .
eth:slackMaxDeficitMinusS2 a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "slackMaxDeficitMinusS2" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "derived coherence: max d - S2 >= 0" .
eth:weightedDeficit a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "weightedDeficit" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "D = sum_p lambda_p d_p" .
eth:epistemicPenalty a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "epistemicPenalty" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "u = U_E * d_K / q_K" .
eth:facetExposurePhi a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "facetExposurePhi" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "weighted facet-level exposure phi" .
eth:adequacyRaw a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "adequacyRaw" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "adequacy before the veto cap" .
eth:adequacy a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "adequacy" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "adequacy of the central band" .
eth:adequacyLow a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "adequacyLow" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "pessimistic adequacy: the verdict is taken on this" .
eth:adequacyHigh a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "adequacyHigh" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "optimistic adequacy" .
eth:adequacyBand a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "adequacyBand" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "width of the confidence band" .
eth:materialGapLow a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "materialGapLow" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "largest uncompensable duty gap" .
eth:materialFacet a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "materialFacet" ; rdfs:domain eth:Confrontation ; rdfs:range eth:Facet ; rdfs:comment "facet producing the material gap" .
eth:decision a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "decision" ; rdfs:domain eth:Confrontation ; rdfs:range eth:Decision ; rdfs:comment "verdict of the ladder" .
eth:decisionBar a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "decisionBar" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "bar the verdict is measured against" .
eth:declaredStakesSum a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "declaredStakesSum" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "severity + irreversibility + prudential" .
eth:stakesWeighted a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "stakesWeighted" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "weighted stakes used by veto and ladder" .
eth:sigmaFloor a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "sigmaFloor" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "prudential floor sigma" .
eth:failureProbability a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "failureProbability" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "p_fail = 1 - sum_p mu_p l_p" .
eth:reliability a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "reliability" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "1 - p_fail" .
eth:riskRatio a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "riskRatio" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "(p_fail + sigma) / (1 + sigma)" .
eth:residualRisk a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "residualRisk" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "R_r = R_c * (p_fail + sigma) / (1 + sigma)" .
eth:riskAttenuation a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "riskAttenuation" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "derived coherence: R_c - R_r >= 0" .
eth:harmScale a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "harmScale" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:double ; rdfs:comment "exposure-weighted harm scale" .
eth:guardFailureCount a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "guardFailureCount" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:integer ; rdfs:comment "number of hard guards breached" .
eth:worstPillar a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "worstPillar" ; rdfs:domain eth:Confrontation ; rdfs:range eth:Pillar ; rdfs:comment "pillar with the largest guarded deficit" .
eth:worstFacet a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "worstFacet" ; rdfs:domain eth:Confrontation ; rdfs:range eth:Facet ; rdfs:comment "facet with the largest gap" .
eth:vetoPillar a owl:ObjectProperty ; rdfs:label "vetoPillar" ; rdfs:domain eth:Confrontation ; rdfs:range eth:Pillar ; rdfs:comment "pillar whose level is below its theta" .
eth:hardVetoPillar a owl:ObjectProperty ; rdfs:label "hardVetoPillar" ; rdfs:domain eth:Confrontation ; rdfs:range eth:Pillar ; rdfs:comment "pillar in hard veto (level < theta - delta)" .
eth:hasGuardFailure a owl:ObjectProperty ; rdfs:label "hasGuardFailure" ; rdfs:domain eth:Confrontation ; rdfs:range eth:GuardFailure ; rdfs:comment "one breached guard" .
eth:guardFacet a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "guardFacet" ; rdfs:domain eth:GuardFailure ; rdfs:range eth:Facet ; rdfs:comment "facet whose guard is breached" .
eth:guardPillar a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "guardPillar" ; rdfs:domain eth:GuardFailure ; rdfs:range eth:Pillar ; rdfs:comment "pillar the guard caps" .
eth:observedAtGuard a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "observedAtGuard" ; rdfs:domain eth:GuardFailure ; rdfs:range xsd:double ; rdfs:comment "observed level in the guarded facet" .
eth:guardFloor a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "guardFloor" ; rdfs:domain eth:GuardFailure ; rdfs:range xsd:double ; rdfs:comment "guard floor of that facet" .
eth:guardPolicy a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "guardPolicy" ; rdfs:domain eth:GuardFailure ; rdfs:range eth:AggregationPolicy ; rdfs:comment "aggregation policy of the facet" .
eth:chainCase a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "chainCase" ; rdfs:domain eth:ConfrontationChain ; rdfs:range eth:EthicalCase ; rdfs:comment "case the chain serves" .
eth:delegationChain a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "delegationChain" ; rdfs:domain eth:ConfrontationChain ; rdfs:range eth:DelegationChain ; rdfs:comment "delegation chain of the layering" .
eth:dutyStrength a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "dutyStrength" ; rdfs:domain eth:Obligation ; rdfs:range xsd:double ; rdfs:comment "strength of the duty 0..1" .
eth:breachConsequence a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "breachConsequence" ; rdfs:domain eth:Prohibition ; rdfs:range xsd:string ; rdfs:comment "what happens when the prohibition is breached" .
eth:permissionScope a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "permissionScope" ; rdfs:domain eth:Permission ; rdfs:range xsd:string ; rdfs:comment "scope of the permission" .
eth:conditionalOn a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "conditionalOn" ; rdfs:domain eth:Permission ; rdfs:range xsd:string ; rdfs:comment "condition that keeps the permission valid" .
eth:hasInstantiateCount a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "hasInstantiateCount" ; rdfs:domain eth:Entity ; rdfs:range xsd:integer ; rdfs:comment "number of confrontations instantiated" .
eth:epistemicAbstention a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "epistemicAbstention" ; rdfs:domain eth:Confrontation ; rdfs:range xsd:boolean ; rdfs:comment "E29 epistemic abstention fired" .
eth:chainEpistemicAbstention a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "chainEpistemicAbstention" ; rdfs:domain eth:ConfrontationChain ; rdfs:range xsd:boolean ; rdfs:comment "every layer of the chain abstained" .
eth:hasCaseCount a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "hasCaseCount" ; rdfs:domain eth:Entity ; rdfs:range xsd:integer ; rdfs:comment "number of cases instantiated" .
eth:hasAgentCount a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "hasAgentCount" ; rdfs:domain eth:Entity ; rdfs:range xsd:integer ; rdfs:comment "number of agents instantiated" .

# the four structural terms of Eq. 10, per pillar deficit
eth:lamW a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "lamW" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "salience of pillar W in the weighted deficit D" .
eth:muW a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "muW" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "reliability weight of pillar W in the failure probability (E12')" .
eth:thetaW a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "thetaW" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "veto threshold of pillar W" .
eth:lamC a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "lamC" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "salience of pillar C in the weighted deficit D" .
eth:muC a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "muC" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "reliability weight of pillar C in the failure probability (E12')" .
eth:thetaC a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "thetaC" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "veto threshold of pillar C" .
eth:lamM a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "lamM" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "salience of pillar M in the weighted deficit D" .
eth:muM a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "muM" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "reliability weight of pillar M in the failure probability (E12')" .
eth:thetaM a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "thetaM" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "veto threshold of pillar M" .
eth:lamK a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "lamK" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "salience of pillar K in the weighted deficit D" .
eth:muK a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "muK" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "reliability weight of pillar K in the failure probability (E12')" .
eth:thetaK a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "thetaK" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "veto threshold of pillar K" .
eth:gamma a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "gamma" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "coefficient of S2" .
eth:eta a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "eta" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "coefficient of S3" .
eth:omega a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "omega" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "coefficient of S4" .
eth:rho a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "rho" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "coefficient of the epistemic penalty u" .
eth:delta a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "delta" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "coefficient of the facet exposure phi" .
eth:uncertaintyKappa a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "uncertaintyKappa" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "kappa of the uncertainty-penalised mean" .
eth:hardVetoDelta a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "hardVetoDelta" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "extra distance above theta for a hard veto" .
eth:materialGap a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "materialGap" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "a duty gap at least this large is material" .
eth:criticalProhibitGap a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "criticalProhibitGap" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "material gap on a critical duty -> categorical" .
eth:capBase a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "capBase" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "share of the uncompensable gap counted at zero stakes" .
eth:capStakesGain a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "capStakesGain" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "extra share counted per unit of stakes" .
eth:stakesVetoMin a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "stakesVetoMin" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "stakes above which a guard breach is categorical" .
eth:prohibitStakesMin a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "prohibitStakesMin" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "proportionality gate of the ladder" .
eth:prohibitNeedsMaterial a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "prohibitNeedsMaterial" ; rdfs:domain eth:Calibration ; rdfs:range xsd:boolean ; rdfs:comment "E13c: prohibition requires a concentrated duty shortfall" .
eth:vetoSlack a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "vetoSlack" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "how far a triggered veto still forces review" .
eth:totalPenaltyBudget a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "totalPenaltyBudget" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "gamma+eta+omega+rho+delta must not exceed it" .
eth:penaltySum a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "penaltySum" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "derived: gamma+eta+omega+rho+delta" .
eth:lamSum a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "lamSum" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "derived: sum of the four pillar saliences" .
eth:muSum a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "muSum" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "derived: sum of the four reliability weights" .
eth:barBase a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "barBase" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "base of the decision bar" .
eth:barSeverity a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "barSeverity" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "bar increment per severity band" .
eth:barIrreversibility a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "barIrreversibility" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "bar increment for irreversibility" .
eth:barPrudential a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "barPrudential" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "bar increment per prudential step" .
eth:barHorizon a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "barHorizon" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "bar increment per horizon step" .
eth:prohibitMargin a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "prohibitMargin" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "Aa below bar-margin -> categorical prohibition" .
eth:guardsMargin a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "guardsMargin" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "Aa below bar+margin -> allow only with guards" .
eth:ratioProhibit a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "ratioProhibit" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "risk-ratio route to prohibition" .
eth:ratioReview a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "ratioReview" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "risk-ratio route to review" .
eth:ratioGuards a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "ratioGuards" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "risk-ratio route to guards" .
eth:hysteresis a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "hysteresis" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "E13d: verdict may not loosen below bar+hysteresis" .
eth:abstainUncertainty a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "abstainUncertainty" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "E29: abstention triggers at this epistemic uncertainty" .
eth:abstainKnowledgeFloor a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "abstainKnowledgeFloor" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "E29: and when the knowledge level is at most this" .
eth:stakeWeightSeverity a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "stakeWeightSeverity" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "stakes coefficient of severity" .
eth:stakeWeightIrreversibility a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "stakeWeightIrreversibility" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "stakes coefficient of irreversibility" .
eth:stakeWeightPrudential a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "stakeWeightPrudential" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "stakes coefficient of prudential posture" .
eth:stakeWeightHorizon a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "stakeWeightHorizon" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "stakes coefficient of horizon" .
eth:stakeWeightSum a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "stakeWeightSum" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "derived: sum of the four stakes coefficients" .
eth:epsilon a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "epsilon" ; rdfs:domain eth:Calibration ; rdfs:range xsd:double ; rdfs:comment "numerical tolerance of the model" .
eth:severityValue a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "severityValue" ; rdfs:domain eth:SeverityBand ; rdfs:range xsd:double ; rdfs:comment "numeric value of the band" .
eth:prudentialValue a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "prudentialValue" ; rdfs:domain eth:PrudentialMode ; rdfs:range xsd:double ; rdfs:comment "numeric value of the posture" .
eth:reversibilityValue a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "reversibilityValue" ; rdfs:domain eth:Reversibility ; rdfs:range xsd:double ; rdfs:comment "numeric value" .
eth:horizonValue a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "horizonValue" ; rdfs:domain eth:TemporalHorizon ; rdfs:range xsd:double ; rdfs:comment "numeric value" .
eth:permissiveness a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "permissiveness" ; rdfs:domain eth:Decision ; rdfs:range xsd:integer ; rdfs:comment "ordinal position in the ladder (0 most restrictive)" .
eth:hasSlot a owl:ObjectProperty ; rdfs:label "hasSlot" ; rdfs:domain eth:StructuralTerm ; rdfs:range eth:LatticeSlot ; rdfs:comment "slot belonging to a structural term" .
eth:termCoefficient a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "termCoefficient" ; rdfs:domain eth:StructuralTerm ; rdfs:range xsd:double ; rdfs:comment "coefficient of the term in Eq. 10" .
eth:termWeightSum a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "termWeightSum" ; rdfs:domain eth:StructuralTerm ; rdfs:range xsd:double ; rdfs:comment "derived: the slots of the term must sum to 1" .
