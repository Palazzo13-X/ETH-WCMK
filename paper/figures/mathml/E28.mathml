<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><mtable rowspacing="0.5ex"><mtr><mtd><mi>c</mi><mi>a</mi><mi>r</mi><mi>r</mi><mi>i</mi><mi>e</mi><mi>d</mi><mo>(</mo><msub><mrow><mi>L</mi></mrow><mrow><mi>s</mi><mi>y</mi><mi>s</mi><mi>t</mi><mi>e</mi><mi>m</mi></mrow></msub><mo>)</mo><mo>=</mo><mi>W</mi><mo>,</mo><mi>C</mi><mo>,</mo><mi>M</mi><mo>,</mo><mi>K</mi><mo>,</mo><mi> </mi><mi>c</mi><mi>a</mi><mi>r</mi><mi>r</mi><mi>i</mi><mi>e</mi><mi>d</mi><mo>(</mo><msub><mrow><mi>L</mi></mrow><mrow><mi>m</mi><mi>o</mi><mi>d</mi><mi>e</mi><mi>l</mi></mrow></msub><mo>)</mo><mo>=</mo><mi>c</mi><mi>a</mi><mi>r</mi><mi>r</mi><mi>i</mi><mi>e</mi><mi>d</mi><mo>(</mo><msub><mrow><mi>L</mi></mrow><mrow><mi>o</mi><mi>p</mi><mi>e</mi><mi>r</mi><mi>a</mi><mi>t</mi><mi>o</mi><mi>r</mi></mrow></msub><mo>)</mo><mo>=</mo><mi>C</mi><mo>,</mo><mi>K</mi></mtd></mtr><mtr><mtd><mi>f</mi><mi>d</mi><mi>e</mi><mi>l</mi><mi>e</mi><mi>g</mi><mi>á</mi><mi>v</mi><mi>e</mi><mi>l</mi><mi>Leftrightarrow</mi><mi>p</mi><mo>:</mo><msub><mrow><mi>β</mi></mrow><mrow><mi>f</mi><mi>p</mi></mrow></msub><mo>&gt;</mo><mn>0</mn><mi>subseteq</mi><mi>c</mi><mi>a</mi><mi>r</mi><mi>r</mi><mi>i</mi><mi>e</mi><mi>d</mi><mo>(</mo><msub><mrow><mi>L</mi></mrow><mrow><mi>d</mi><mi>e</mi><mi>l</mi><mi>e</mi><mi>g</mi><mi>a</mi><mi>t</mi><mi>e</mi></mrow></msub><mo>)</mo><mi> </mi><mo>(</mo><mn>32</mn><mi>d</mi><mi>e</mi><mn>33</mn><mi>f</mi><mi>a</mi><mi>c</mi><mi>e</mi><mi>t</mi><mi>a</mi><mi>s</mi><mi>e</mi><mi>x</mi><mi>i</mi><mi>g</mi><mi>e</mi><mi>m</mi><mi>a</mi><mi>c</mi><mi>a</mi><mi>m</mi><mi>a</mi><mi>d</mi><mi>a</mi><mi>a</mi><mi>c</mi><mi>c</mi><mi>o</mi><mi>u</mi><mi>n</mi><mi>t</mi><mi>a</mi><mi>b</mi><mi>l</mi><mi>e</mi><mo>)</mo></mtd></mtr><mtr><mtd><msubsup><mrow><mi>x</mi></mrow><mrow><mi>f</mi></mrow><mrow><mi>c</mi><mi>h</mi><mi>a</mi><mi>i</mi><mi>n</mi></mrow></msubsup><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><munder><mo>∑</mo><mrow><mi>p</mi></mrow></munder><mrow><m